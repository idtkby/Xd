    AdvancedTab:CreateButton({
        Name = "Remove Enemy & EnemyModel",
        Callback = function()
            local currentTime = tick()
            
            -- Cơ chế chống spam (Cooldown)
            if currentTime - lastClearTime < CLEAR_COOLDOWN then
                Rayfield:Notify({
                    Title = "Cảnh báo",
                    Content = "Bạn đang bấm quá nhanh! Vui lòng đợi chút.",
                    Duration = 1.5,
                    Image = 6026568198,
                })
                return
            end
            lastClearTime = currentTime

            local deletedCount = 0

            -- Quét và xóa các đối tượng thuộc diện Enemy hoặc EnemyModel trong Workspace
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj and obj.Parent then
                    local name = obj.Name
                    -- Kiểm tra nếu tên khớp với Enemy hoặc EnemyModel (bao gồm cả dạng Model hoặc BasePart)
                    if name == "Enemy" or name == "EnemyModel" or name:match("^Enemy") then
                        pcall(function()
                            obj:Destroy()
                            deletedCount = deletedCount + 1
                        end)
                    end
                end
            end

            -- Thông báo kết quả
            Rayfield:Notify({
                Title = "Dọn dẹp thành công",
                Content = string.format("Đã xóa bỏ %d đối tượng Enemy.", deletedCount),
                Duration = 2,
            })
        end,
    })
    
end)
